# ORDERS SERVICE
ORDERS_HTTP_PORT=3000
ORDERS_DB_HOST=postgres   # usar 'localhost' para desarrollo local fuera de Docker
ORDERS_DB_PORT=5432
ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=orders_pass
ORDERS_DB_NAME=orders_db

# AUDIT SERVICE
AUDIT_HTTP_PORT=3001
AUDIT_TCP_PORT=4001
AUDIT_MONGO_URI=mongodb://mongo:27017/audit_db

# INVENTORY SERVICE
INVENTORY_HTTP_PORT=3002
INVENTORY_TCP_PORT=4002
INVENTORY_DB_HOST=postgres-inventory   # usar 'localhost' para desarrollo local fuera de Docker
INVENTORY_DB_PORT=5432
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_pass
INVENTORY_DB_NAME=inventory_db
INVENTORY_RESERVATION_TTL_MINUTES=15
INVENTORY_REAP_BATCH_SIZE=100

# SHARED
AUDIT_TCP_HOST=audit
INVENTORY_TCP_HOST=inventory
INVENTORY_SEND_TIMEOUT_MS=3000
INVENTORY_BREAKER_FAILURE_THRESHOLD=5
INVENTORY_BREAKER_RESET_TIMEOUT_MS=15000

# RATE LIMITING (orders service)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# API KEY GUARD (orders service)
API_KEY=your-secret-api-key-here

# OUTBOX POLLER (orders service)
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_SEND_TIMEOUT_MS=5000
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=60000
OUTBOX_PURGE_RETENTION_DAYS=30
